{
  "name": "stripe-integration-v2-1",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.6.2",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm db:generate && pnpm db:push && pnpm dev:runtime",
    "dev:runtime": "pnpm --parallel --filter @stripe-integration/web --filter @stripe-integration/api dev",
    "dev:web": "pnpm --filter @stripe-integration/web dev",
    "dev:api": "pnpm --filter @stripe-integration/api dev",
    "db:generate": "pnpm --filter @stripe-integration/db db:generate",
    "db:push": "pnpm --filter @stripe-integration/db db:push",
    "db:migrate": "pnpm --filter @stripe-integration/db db:migrate",
    "db:seed": "pnpm --filter @stripe-integration/db db:seed",
    "db:studio": "pnpm --filter @stripe-integration/db db:studio",
    "setup:demo": "pnpm db:generate && pnpm db:push && pnpm db:seed",
    "demo": "pnpm install && pnpm setup:demo && pnpm dev",
    "demo:refresh": "pnpm db:push && pnpm db:seed",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint"
  }
}
